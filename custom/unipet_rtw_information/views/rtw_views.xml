<odoo>
    <record id="view_rtw_trailer_form" model="ir.ui.view">
        <field name="name">rtw_information.rtw_trailer.form</field>
        <field name="model">rtw_information.trailer</field>
        <field name="arch" type="xml">
            <form string="RTW Trailer">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="manufacturer" />
                        <field name="is_rigid"/>
                        <field name="capacity" readonly="1" />
                        <field name="contractor"/>
                        <field name="compartments">
                            <list editable="bottom">
                                <field name="name" readonly="1"/>
                                <field name="capacity"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rtw_tractor_form" model="ir.ui.view">
        <field name="name">rtw_information.rtw_tractor.form</field>
        <field name="model">rtw_information.tractor</field>
        <field name="arch" type="xml">
            <form string="RTW Tractor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contractor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rtw_tractor_list" model="ir.ui.view">
        <field name="name">rtw_information.rtw_tractor.list</field>
        <field name="model">rtw_information.tractor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contractor"/>
            </list>
        </field>
    </record>

    <record id="view_rtw_trailer_list" model="ir.ui.view">
        <field name="name">rtw_information.rtw_trailer.list</field>
        <field name="model">rtw_information.trailer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="is_rigid"/>
                <field name="capacity" />
                <field name="contractor"/>
            </list>
        </field>
    </record>

    <record id="action_rtw_trailer_information" model="ir.actions.act_window">
        <field name="name">RTW Trailers</field>
        <field name="res_model">rtw_information.trailer</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_rtw_tractor_information" model="ir.actions.act_window">
        <field name="name">RTW Tractors</field>
        <field name="res_model">rtw_information.tractor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rtw_information_root" name="RTW Management">
            <menuitem id="menu_rtw_information_trailer_action" action="action_rtw_trailer_information" />      
            <menuitem id="menu_rtw_information_tractor_action" action="action_rtw_tractor_information" />      
    </menuitem>
</odoo>