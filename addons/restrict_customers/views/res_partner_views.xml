<odoo>
    <record id="view_partner_form_fuel_approval" model="ir.ui.view">
        <field name="name">res.partner.form.fuel.approval</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']/group" position="inside">
                <group string="Fuel Approval" class="fuel_approval_group">
                    <field name="approved_diesel"/>
                    <field name="approved_gasoline"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
